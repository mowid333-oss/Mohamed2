rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-\\.]+$');
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // User Alert Rules
      match /alerts/{alertId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(alertId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.symbol is string &&
          request.resource.data.symbol.size() <= 30;
        allow update: if isOwner(userId) && isValidId(alertId) &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User Watchlist
      match /watchlist/{symbol} {
        allow read, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(symbol) &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }

      // User Portfolio Trades
      match /portfolio/{tradeId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(tradeId) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.symbol is string;
        allow update: if isOwner(userId) && isValidId(tradeId) &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(userId);
      }
    }

    // Daily Market Analysis Reports - Public read
    match /dailyReports/{reportDate} {
      allow read, list: if true;
      allow write: if isSignedIn();
    }
  }
}
